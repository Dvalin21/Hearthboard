# Hearthboard release keystore configuration
# Copy this file to keystore.properties and fill in your values.
# The keystore file itself must NOT be committed to git.
#
# HOW TO GENERATE A KEYSTORE:
#   keytool -genkey -v \
#     -keystore openlight-release.jks \
#     -alias openlight \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=openlight-release.jks
storePassword=
keyAlias=openlight
keyPassword=
