<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext to loopback and RFC1918 LAN hosts (self-hosted servers) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
